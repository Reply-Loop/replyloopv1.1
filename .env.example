# Copy to .env.local for local work. Set the same keys in Vercel project settings.
# Never commit real values.

# Production origin, no trailing slash. Used for canonicals, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://reply-loop.com

# GA4 measurement ID (G-XXXXXXXXXX). Analytics load only after cookie consent. Wired in Phase 5.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content value only). Wired in Phase 2.
NEXT_PUBLIC_GSC_VERIFICATION=

# Proof placeholders. Default hidden in production. Set "true" only on a preview deploy.
NEXT_PUBLIC_SHOW_PROOF_PLACEHOLDERS=false
